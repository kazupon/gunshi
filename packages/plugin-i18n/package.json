{
  "name": "@gunshi/plugin-i18n",
  "version": "1.0.0-rc.6",
  "description": "internationalization plugin for gunshi",
  "keywords": [
    "cli",
    "gunshi",
    "i18n",
    "internationalization",
    "plugin"
  ],
  "bugs": {
    "url": "https://github.com/kazupon/gunshi/issues"
  },
  "license": "MIT",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/gunshi.git",
    "directory": "packages/plugin-i18n"
  },
  "funding": "https://github.com/sponsors/kazupon",
  "files": [
    "lib"
  ],
  "type": "module",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./lib/*",
        "./*"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "build:docs": "tsx ../../scripts/api-references.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@gunshi/plugin": "workspace:*"
  },
  "devDependencies": {
    "@gunshi/bone": "workspace:*",
    "@gunshi/plugin-global": "workspace:*",
    "@gunshi/plugin-renderer": "workspace:*",
    "@gunshi/resources": "workspace:*",
    "@gunshi/shared": "workspace:*",
    "@intlify/core-base": "12.0.0-alpha.9",
    "gunshi": "workspace:*",
    "messageformat": "4.1.0",
    "publint": "catalog:"
  },
  "peerDependencies": {
    "@gunshi/plugin-global": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@gunshi/plugin-global": {
      "optional": true
    }
  },
  "engines": {
    "node": ">= 22"
  }
}
