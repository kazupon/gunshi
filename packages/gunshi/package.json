{
  "name": "gunshi",
  "version": "1.0.0-rc.6",
  "description": "Modern javascript command-line library",
  "keywords": [
    "args",
    "argument",
    "argv",
    "cli",
    "command",
    "option"
  ],
  "bugs": {
    "url": "https://github.com/kazupon/gunshi/issues"
  },
  "license": "MIT",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/gunshi.git",
    "directory": "packages/gunshi"
  },
  "funding": "https://github.com/sponsors/kazupon",
  "files": [
    "AGENTS.md",
    "lib",
    "skills"
  ],
  "type": "module",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./lib/*",
        "./*"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./bone": {
      "types": "./lib/bone.d.ts",
      "import": "./lib/bone.js",
      "require": "./lib/bone.js",
      "default": "./lib/bone.js"
    },
    "./definition": {
      "types": "./lib/definition.d.ts",
      "import": "./lib/definition.js",
      "require": "./lib/definition.js",
      "default": "./lib/definition.js"
    },
    "./plugin": {
      "types": "./lib/plugin.d.ts",
      "import": "./lib/plugin.js",
      "require": "./lib/plugin.js",
      "default": "./lib/plugin.js"
    },
    "./context": {
      "types": "./lib/context.d.ts",
      "import": "./lib/context.js",
      "require": "./lib/context.js",
      "default": "./lib/context.js"
    },
    "./renderer": {
      "types": "./lib/renderer.d.ts",
      "import": "./lib/renderer.js",
      "require": "./lib/renderer.js",
      "default": "./lib/renderer.js"
    },
    "./generator": {
      "types": "./lib/generator.d.ts",
      "import": "./lib/generator.js",
      "require": "./lib/generator.js",
      "default": "./lib/generator.js"
    },
    "./utils": {
      "types": "./lib/utils.d.ts",
      "import": "./lib/utils.js",
      "require": "./lib/utils.js",
      "default": "./lib/utils.js"
    },
    "./combinators": {
      "types": "./lib/combinators.d.ts",
      "import": "./lib/combinators.js",
      "require": "./lib/combinators.js",
      "default": "./lib/combinators.js"
    },
    "./agent": {
      "types": "./lib/agent.d.ts",
      "import": "./lib/agent.js",
      "require": "./lib/agent.js",
      "default": "./lib/agent.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@gunshi/plugin-global": "workspace:*",
    "@gunshi/plugin-i18n": "workspace:*",
    "@gunshi/plugin-renderer": "workspace:*",
    "@gunshi/resources": "workspace:*",
    "@gunshi/shared": "workspace:*",
    "@types/node": "catalog:",
    "args-tokens": "catalog:",
    "publint": "catalog:",
    "std-env": "^4.1.0",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">= 22"
  }
}
