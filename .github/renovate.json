{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "extends": ["config:recommended", ":preserveSemverRanges"],
  "labels": ["deps"],
  "ignoreDeps": ["gunshi019"],
  "major": {
    "automerge": false
  },
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchPackageNames": [
        "typescript",
        "vite-plus",
        "@kazupon/vp-config",
        "knip",
        "vitest",
        "pkg-pr-new",
        "bumpp"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Update vitest with Vite+, which bundles its own vitest: the playground example imports vitest from the root",
      "groupName": "vite-plus",
      "matchPackageNames": ["vite-plus", "vitest", "@vitest/coverage-v8"]
    }
  ]
}
