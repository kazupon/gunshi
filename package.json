{
  "name": "gunshi-monorepo",
  "description": "Monorepo for gunshi - Modern javascript command-line library",
  "private": true,
  "version": "1.0.0-rc.6",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/kazupon",
  "bugs": {
    "url": "https://github.com/kazupon/gunshi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazupon/gunshi.git"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">= 22"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": ">=22",
        "onFail": "error"
      },
      {
        "name": "bun",
        "version": ">=1.1",
        "onFail": "ignore"
      }
    ]
  },
  "type": "module",
  "scripts": {
    "bench:mitata": "node --expose-gc bench/mitata.js",
    "bench:vitest": "vp test bench --run",
    "build": "pnpm -r build",
    "build:bone": "pnpm -F @gunshi/bone build",
    "build:definition": "pnpm -F @gunshi/definition build",
    "build:docs": "pnpm run build:plugin:renderer && pnpm run build:plugin:i18n && pnpm -F @gunshi/docs build",
    "build:gunshi": "pnpm -F gunshi build",
    "build:plugin": "pnpm -F @gunshi/plugin build",
    "build:plugin:completion": "pnpm -F @gunshi/plugin-completion build",
    "build:plugin:dryrun": "pnpm -F @gunshi/plugin-dryrun build",
    "build:plugin:global": "pnpm -F @gunshi/plugin-global build",
    "build:plugin:i18n": "pnpm -F @gunshi/plugin-i18n build",
    "build:plugin:renderer": "pnpm -F @gunshi/plugin-renderer build",
    "build:plugin:suggestion": "pnpm -F @gunshi/plugin-suggestion build",
    "build:resources": "pnpm -F @gunshi/resources build",
    "build:shared": "pnpm -F @gunshi/shared build",
    "changelog": "gh-changelogen --repo=kazupon/gunshi",
    "clean": "git clean -df",
    "dev:docs": "pnpm -F @gunshi/docs dev",
    "e2e": "vp test run --config vitest.e2e.config.ts",
    "fix": "pnpm run \"/^fix:/\"",
    "fix:check": "vp check --fix",
    "fix:knip": "knip --fix --no-exit-code",
    "lint": "pnpm run \"/^lint:/\"",
    "lint:check": "vp check",
    "lint:knip": "knip",
    "prepare": "git config --local core.hooksPath .githooks",
    "preview:docs": "pnpm -F @gunshi/docs preview",
    "release": "bumpp",
    "test": "vp test run --typecheck",
    "test:core": "vp test run --typecheck packages/gunshi",
    "test:plugin-completion": "vp test run --typecheck packages/plugin-completion",
    "test:plugin-dryrun": "vp test run --typecheck packages/plugin-dryrun",
    "test:plugin-global": "vp test run --typecheck packages/plugin-global",
    "test:plugin-i18n": "vp test run --typecheck packages/plugin-i18n",
    "test:plugin-renderer": "vp test run --typecheck packages/plugin-renderer",
    "test:plugin-suggestion": "vp test run --typecheck packages/plugin-suggestion"
  },
  "devDependencies": {
    "@kazupon/vp-config": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.1.0",
    "bumpp": "^12.0.0",
    "gh-changelogen": "^2.0.0",
    "gunshi019": "npm:gunshi@0.19.0",
    "knip": "^6.45.1",
    "mitata": "^1.0.34",
    "pkg-pr-new": "^0.0.93",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitepress-api-references": "catalog:",
    "vitest": "5.1.0"
  }
}
